#!/usr/bin/env bash
set -euo pipefail

output=""
while (($# > 0)); do
  case "$1" in
    --output)
      output="${2:-}"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

[[ -n "$output" ]] || exit 2
if [[ -n ${FAKE_CURL_EXIT:-} ]]; then
  exit "$FAKE_CURL_EXIT"
fi
if [[ "$output" == "-" ]]; then
  cat -- "${FAKE_CURL_SOURCE:?FAKE_CURL_SOURCE is required}"
else
  cp -- "${FAKE_CURL_SOURCE:?FAKE_CURL_SOURCE is required}" "$output"
fi
